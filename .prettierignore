# TanStack Router 由 @tanstack/router-plugin 在 vite 构建时重新生成，
# 文件头自己就写着「You should NOT make any changes in this file」。
# 格式化它没有意义：跑一次 `pnpm build` 就被覆盖回去，format:check 会永久红。
src/pages/routeTree.gen.ts

# 锁文件是 pnpm 生成的机器产物
pnpm-lock.yaml

# 构建产物
dist/
target/
**/.nsh/

# vendor 的第三方 crate 源码保持原样（patch 用，diff 越小越好）；
# 不 ignore 的话 format:check 会红在别人的代码上（workspace 化后 vendor 在仓库根）
vendor/

# skill 资产不是本项目代码（对齐 eslint.config.js 的 .agents 豁免）；
# 不 ignore 的话 format:check 会红在 skill 自带的示例文件上
.agents/

# docs 是中文散文文档不是代码：表格对齐、手动换行是内容的一部分，
# prettier 的 markdown 重排只会制造 diff 噪音
docs/

# Loomy 运行时工作目录不是项目代码（对齐 .gitignore）；不 ignore 的话
# format:check 会红在会话附件上
.loomy-attachments/

# 抓包工具链的本地 venv（Python 生态的 JSON/JS 不该被前端格式化器扫）
.venv-capture/
