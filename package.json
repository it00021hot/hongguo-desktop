    "nsh:check": "node scripts/nsh.mjs check",
    "nsh:test": "node scripts/nsh.mjs test",
    "build": "node scripts/nsh.mjs check",
    "test": "node --test scripts/*.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
