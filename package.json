  "description": "红果短剧桌面客户端（Windows / macOS）",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "cd crates/hongguo-tauri-app && tauri",
    "tauri:dev": "cd crates/hongguo-tauri-app && tauri dev",
    "tauri:build": "cd crates/hongguo-tauri-app && tauri build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "cdp": "node scripts/cdp.mjs",
    "wd": "node scripts/webdriver.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.105.1",
    "@tanstack/react-router": "^1.170.46",
