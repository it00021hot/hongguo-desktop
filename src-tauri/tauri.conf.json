{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "红果短剧下载器",
  "version": "2.0.0",
  "identifier": "com.hongguo.downloader",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "红果短剧下载器",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https: http://asset.localhost http://hongguo-cover.localhost",
        "media-src": "'self' asset: http://asset.localhost hongguo-stream: http://hongguo-stream.localhost hongguo-local: http://hongguo-local.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.qznovelvod.com https://*.byteimg.com https://*.bytecdn.cn"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOWNLOAD_DIR/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "GPL-3.0",
    "category": "Video",
    "shortDescription": "红果短剧全集批量下载器",
    "longDescription": "浏览、搜索、批量下载、在线播放、一键合并、磁盘清理。解密/解复用/合并为纯 Rust 零外部依赖，HEVC 转 H.264 可选调用系统 ffmpeg 加速，安装包不捆绑外部二进制。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
