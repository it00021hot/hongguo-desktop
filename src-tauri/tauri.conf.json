{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hongguo",
  "version": "0.4.1",
  "identifier": "com.hongguo.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hongguo",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "img-src": "'self' data: blob: https: http://asset.localhost hongguo-cover: http://hongguo-cover.localhost",
        "media-src": "'self' asset: http://asset.localhost hongguo-stream: http://hongguo-stream.localhost hongguo-local: http://hongguo-local.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://*.qznovelvod.com https://*.byteimg.com https://*.bytecdn.cn"
      },
      "assetProtocol": {
        "enable": true,
        "scope": ["$DOWNLOAD_DIR/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Copyright (c) 2026 hongguo-desktop contributors · PolyForm Noncommercial 1.0.0",
    "category": "Video",
    "shortDescription": "红果短剧桌面客户端",
    "longDescription": "浏览、搜索、批量下载、在线播放、一键合并、磁盘清理。解密/解复用/合并为纯 Rust 零外部依赖，HEVC 转 H.264 可选调用系统 ffmpeg 加速，安装包不捆绑外部二进制。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "template": "nsis/installer.nsi",
        "installerHooks": "nsis/installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "files": {
        "Resources/en.lproj/InfoPlist.strings": "i18n/en.lproj/InfoPlist.strings",
        "Resources/zh-Hans.lproj/InfoPlist.strings": "i18n/zh-Hans.lproj/InfoPlist.strings",
        "Resources/zh-Hant.lproj/InfoPlist.strings": "i18n/zh-Hant.lproj/InfoPlist.strings"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/it00021hot/hongguo-desktop/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4QTVFRERBQTM5RDkwNDMKUldSRGtKMmoydTJsU0JGQ01oc3JIMUNROWJCMU9zenFYdkpQZ0dQd1NmckdPdG4xejZIaG1uTS8K",
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
