#!/usr/bin/env bash
# 提交前置检查：当前宿主严格 Clippy、格式与资源校验。
#
# 启用（克隆后执行一次）：
#   git config core.hooksPath .githooks
#
set -euo pipefail
cd "$(dirname "$0")/.."

STRICT='-D warnings -D clippy::allow_attributes'

echo '[pre-commit] authenticated native SDK'
cargo build-tool setup

echo '[pre-commit] cargo clippy（本机宿主）'
cargo clippy --workspace --all-targets -- $STRICT

echo '[pre-commit] cargo fmt / enhancement assets'
cargo fmt -- --check
cargo build-tool enhancement-assets

echo '[pre-commit] 全部通过'
